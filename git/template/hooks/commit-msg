#!/usr/bin/env bash
# commit-msg — template hook: conventional commits baseline check
#
# Safety net for repos where `pre-commit install --hook-type commit-msg`
# hasn't been run yet. Once you run that, the framework overwrites this
# hook and takes over — this will no longer execute.

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

commit_msg=$(cat "$1")

# Pass through merge commits, revert commits, and fixup/squash commits
if echo "$commit_msg" | grep -qE "^(Merge|Revert|fixup!|squash!)"; then
  exit 0
fi

# Conventional commits pattern:
# type(optional scope): description
# Types: feat fix docs style refactor test chore perf ci build revert
pattern="^(feat|fix|docs|style|refactor|test|chore|perf|ci|build|revert)(\(.+\))?(!)?: .{1,}"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo -e "${RED}[commit-msg] Commit message does not follow Conventional Commits format.${NC}"
  echo -e "${YELLOW}Expected:${NC} type(scope): description"
  echo -e "${YELLOW}Example:${NC}  feat(auth): add OAuth2 login"
  echo -e "${YELLOW}Types:${NC}    feat fix docs style refactor test chore perf ci build revert"
  echo ""
  echo -e "${YELLOW}Your message:${NC} $commit_msg"
  exit 1
fi

exit 0
