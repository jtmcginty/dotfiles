# Global gitignore — applies to every repo on this machine

# ── Secrets directory (chmod 700, sourced by zsh) ─────────────────────────────
.secrets
.secrets/
.secrets/**

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.*

# ── Private keys and certificates ─────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*

# ── Editor ────────────────────────────────────────────────────────────────────
*.swp
*.swo
