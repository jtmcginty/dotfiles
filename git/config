# ~/.config/git/config
# Portable global git settings — tracked in dotfiles.
# Machine-specific settings (user.name, user.email, signing key) go in
# ~/.config/git/config.local and are NOT tracked.

[core]
	editor = nvim
	pager = delta
	autocrlf = input
	eol = lf
	ignorecase = false
	whitespace = trailing-space,space-before-tab

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[branch]
	sort = -committerdate

[merge]
	conflictstyle = zdiff3

[help]
	autocorrect = prompt

[diff]
	colorMoved = zebra
	submodule = log

[log]
	abbrevCommit = true
	date = relative

[status]
	submoduleSummary = true

[stash]
	showPatch = true

[commit]
	template = ~/.config/git/commit-template

[delta]
	navigate = true
	side-by-side = true

[interactive]
	diffFilter = delta --color-only

[include]
	path = ~/.config/git/config.local
